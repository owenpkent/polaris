# The keys allowed to sign a Polaris release (docs/releases.md, docs/update-proposal.md section 2).
#
# Format: OpenSSH allowed_signers, one key per line:
#
#   <principal> namespaces="git" <keytype> <key>
#
# for example
#
#   polaris-release namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI...
#
# `cc update --release`, `--to`, and `--check` verify a release tag against a pinned copy of this
# file (command-center/data/release-signers), taken from this file the first time one of them
# runs: an SSH signature with `git verify-tag`, an X.509 signature (the certificate on the eToken,
# scripts/sign-release.ps1) against the ssh-rsa keys here, which are the same RSA keys written the
# way ssh-keygen reads them. A change to this file widens nothing on an install until its owner
# has reviewed it with `cc update --trust-signers`. With no key here, no release can verify.
#
# One-time setup, done once by the owner of the repository (not by an installer):
#
#   ssh-keygen -t ed25519 -f ~/.ssh/polaris-release -C polaris-release
#   git config gpg.format ssh
#   git config user.signingkey ~/.ssh/polaris-release.pub
#
# then add the public key as a line here, in the form above, with ~/.ssh/polaris-release.pub's key
# type and key (the second and third fields of that file), and commit it. A fork keeps its own key
# and its own copy of this file. Lines starting with # are comments.
polaris-release namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILqqDqiDvDnDm6Cf2PgA9bw/YNR7UNACBhbPc0A9My4t
# The RSA key of the OK Studio Inc. EV code-signing certificate (Sectigo, thumbprint
# FC22B5221318F3F3F6B3EB2D969D7F99091557BF), whose private key is on the SafeNet eToken. It signs
# tags as X.509 (scripts/sign-release.ps1); the line is `ssh-keygen -i -m PKCS8` of its public key.
ok-studio-ev namespaces="git" ssh-rsa 
