#!/bin/sh
# Runs the fast test layers before every push: Command Center tests, typecheck, and the
# dashboard unit tests (npm run test:fast). The browser UI tests are left to CI because they
# take much longer. See initiatives/automated-testing.md, Phase 2.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Disable again:           git config --unset core.hooksPath
# Skip for a single push:  git push --no-verify

# A push that only deletes a remote branch has nothing to test.
only_deletes=1
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) ;;
    *) only_deletes=0 ;;
  esac
done
if [ "$only_deletes" -eq 1 ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-push: running the fast test layers (npm run test:fast)"
if ! npm run --silent test:fast > "$(git rev-parse --git-dir)/pre-push.log" 2>&1; then
  echo "pre-push: tests failed, push stopped. Last lines of "$(git rev-parse --git-dir)/pre-push.log":"
  tail -n 40 "$(git rev-parse --git-dir)/pre-push.log"
  exit 1
fi
echo "pre-push: all fast tests passed"
