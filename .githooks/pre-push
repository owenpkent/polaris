#!/bin/sh
# Runs what the CI fast job runs before every push: Command Center tests, typecheck, and the
# dashboard unit tests (npm run test:fast), then the dashboard build (npm run build). The browser
# UI tests are left to CI because they take much longer. Keep this in step with the fast job in
# .github/workflows/test.yml. See initiatives/automated-testing.md, Phase 2.
#
# Enabled by `npm install` (the root prepare script, scripts/setup-hooks.mjs), except in CI.
# By hand:                 git config core.hooksPath .githooks
# Disable again:           git config --unset core.hooksPath
# Skip for a single push:  git push --no-verify

# A push that only deletes a remote branch has nothing to test.
only_deletes=1
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) ;;
    *) only_deletes=0 ;;
  esac
done
if [ "$only_deletes" -eq 1 ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

log="$(git rev-parse --git-dir)/pre-push.log"

echo "pre-push: running the fast test layers (npm run test:fast), then the build (npm run build)"
if ! { npm run --silent test:fast && npm run --silent build; } > "$log" 2>&1; then
  echo "pre-push: checks failed, push stopped. Last lines of $log:"
  tail -n 40 "$log"
  exit 1
fi
echo "pre-push: fast tests and build passed"
