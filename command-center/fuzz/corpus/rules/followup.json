{
  "trigger": {
    "type": "task.completed"
  },
  "conditions": [
    {
      "field": "projectId",
      "op": "in",
      "value": [
        "p1",
        "p2"
      ]
    },
    {
      "field": "dueAt",
      "op": "before",
      "value": "2026-01-15"
    }
  ],
  "actions": [
    {
      "type": "create_followup",
      "title": "Review {title}",
      "dueInDays": 7
    },
    {
      "type": "notify",
      "message": "done"
    }
  ]
}