# libFuzzer dictionary for the task-text target (importer/taskText.ts parseTaskText).
# The first input byte picks the format; the rest is text.
header_title="title,"
header_name="Name;"
header_task="task"
header_priority="priority"
header_due="due"
header_due_date="Due date"
header_notes="notes"
header_status="status"
header_estimate="estimate"
header_estimate_minutes="Estimate (minutes)"
header_assignee="assignee"
header_project="project"
header_section="section"
header_start="start"
status_done="done"
status_open="open"
priority_high="high"
priority_low="low"
date="2026-01-15"
datetime="2026-01-15 09:00"
bullet="- "
star="* "
plus="+ "
unchecked="- [ ] "
checked="- [x] "
indent2="  "
indent4="    "
tab="\x09"
comma=","
semicolon=";"
pipe="|"
quote="\""
doubled_quote="\"\""
quote_comma_quote="\",\""
lf="\x0a"
crlf="\x0d\x0a"
bom="\xef\xbb\xbf"
heading="# "
fence="```"
