# libFuzzer dictionary for the recurrence target (automation/recurrence.ts, core/recurrenceCount.ts).
# First byte picks the previous due date; the rest is the rule.
prefix="RRULE:"
freq_daily="FREQ=DAILY"
freq_weekly="FREQ=WEEKLY"
freq_monthly="FREQ=MONTHLY"
freq_yearly="FREQ=YEARLY"
freq_hourly="FREQ=HOURLY"
interval="INTERVAL="
count="COUNT="
count_one="COUNT=1"
until="UNTIL=20270101"
until_time="UNTIL=20270101T000000Z"
byday="BYDAY="
byday_pos="BYDAY=-1FR"
byday_list="BYDAY=MO,WE,FR"
bymonthday="BYMONTHDAY="
bymonthday_31="BYMONTHDAY=31"
bymonthday_neg="BYMONTHDAY=-1"
bymonth="BYMONTH="
bymonth_feb="BYMONTH=2"
wkst="WKST=SU"
bysetpos="BYSETPOS=1"
byweekno="BYWEEKNO=1"
byhour="BYHOUR=9"
x_from="X-FROM=COMPLETION"
x_other="X-OTHER=1"
semicolon=";"
equals="="
comma=","
space=" "
alias_daily="daily"
alias_weekdays="weekdays"
alias_every="every 2 weeks"
alias_every_n="every 3 months"
proto="__proto__"
constructor="constructor"
