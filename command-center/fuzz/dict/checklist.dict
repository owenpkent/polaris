# libFuzzer dictionary for the checklist target (importer/checklist.ts parseChecklist).
unchecked="- [ ] "
checked="- [x] "
checked_upper="- [X] "
star_unchecked="* [ ] "
empty_box="- [] "
h1="# "
h2="## "
h3="### "
h6="###### "
fence="```"
fence_lang="```md"
tilde_fence="~~~"
indent2="  "
indent4="    "
tab="\x09"
lf="\x0a"
crlf="\x0d\x0a"
cr="\x0d"
blank_line="\x0a\x0a"
nbsp="\xc2\xa0"
bom="\xef\xbb\xbf"
