# libFuzzer dictionary for the pattern target (automation/pattern.ts). Pattern, NUL, then text.
nul="\x00"
caret="^"
dollar="$"
dot="."
star="*"
plus="+"
question="?"
lazy_star="*?"
lazy_plus="+?"
brace_n="{3}"
brace_n_open="{2,}"
brace_n_m="{1,4}"
brace_bad="{,3}"
group_open="("
group_noncapture="(?:"
group_close=")"
alt="|"
class_open="["
class_neg="[^"
class_close="]"
class_range="a-z"
class_digit="\\d"
class_word="\\w"
class_space="\\s"
class_not_digit="\\D"
boundary="\\b"
not_boundary="\\B"
escape_dot="\\."
escape_backslash="\\\\"
hex_escape="\\x41"
unicode_escape="\\u0041"
lookahead="(?="
lookbehind="(?<="
backref="\\1"
named_group="(?<name>"
nested="((a|b)*)+"
redos="(a|aa)+$"
