# libFuzzer dictionary for the due target (core/dueAt.ts). First byte picks the timezone.
day="2026-01-15"
leap="2024-02-29"
t_sep="T"
space=" "
hm="09:30"
hm_one_digit="9:05"
seconds=":00"
seconds_nonzero=":15"
millis=".250"
zulu="Z"
plus_offset="+05:30"
minus_offset="-08:00"
compact_offset="+0530"
midnight="T00:00:00Z"
midnight_short="T00:00Z"
hour_24="24:00"
minute_60="09:60"
