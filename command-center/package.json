{
  "name": "polaris-command-center",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owenpkent/polaris.git",
    "directory": "command-center"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cc": "node src/cli.ts",
    "test": "node --test --test-reporter=spec \"src/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-lines=93 --test-coverage-branches=85 --test-coverage-functions=90 --test-reporter=spec \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "rrule": "^2.8.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  }
}
