{
  "name": "polaris",
  "version": "2.2.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owenpkent/polaris.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cc": "node command-center/src/cli.ts",
    "mockup": "node scripts/mockup.mjs",
    "test": "vitest run",
    "test:fast": "npm --prefix command-center test && npm --prefix command-center run typecheck && vitest run",
    "test:ui": "vite build && playwright test --project desktop --project phone --project desktop-light --project phone-light --project desktop-hc --project phone-landscape --project phone-320",
    "test:all": "npm run test:fast && npm run test:ui",
    "test:android": "npm --prefix mobile run test:device --",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
